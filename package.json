{
  "name": "portafolio-personal", "version": "1.0.0", "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "preview": "node scripts/preview.mjs",
    "build": "npm run validate:cv && ng build",
    "build:pages": "npm run validate:cv && ng build --base-href ./",
    "validate:cv": "node scripts/validate-cv.mjs",
    "package:delivery": "npm run build:pages && powershell -NoProfile -File scripts/package-delivery.ps1"
  },
  "engines": { "node": "^20.19.0 || ^22.12.0 || ^24.0.0" },
  "dependencies": {
    "@angular/common": "~21.2.0", "@angular/compiler": "~21.2.0", "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0", "rxjs": "~7.8.2", "tslib": "^2.8.1"
  },
  "devDependencies": { "@angular/build": "~21.2.0", "@angular/cli": "~21.2.0", "@angular/compiler-cli": "~21.2.0", "typescript": "~5.9.3" }
}
